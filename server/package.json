{
  "name": "fantasy-pickup-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../.env -- node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "dotenv -e ../.env -- vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "2.8.6",
    "express": "4.22.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "8.0.0",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
